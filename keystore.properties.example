# Copia este archivo a keystore.properties (nombre sin .example).
# Reemplaza cada valor EN TU EQUIPO. Nunca subas el archivo real ni la clave.
# storeFile puede ser una ruta ABSOLUTA fuera del repositorio (recomendado).
storeFile=/ruta/privada/firma/pharmamobil-release.jks
storePassword=REEMPLAZAR_LOCALMENTE
keyAlias=pharmamobil
keyPassword=REEMPLAZAR_LOCALMENTE
